# MongoDB Atlas
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=vit_hostel_connect

# Generate a long random secret for JWT signing. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Brevo transactional email
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=VIT Hostel Connect
EMAIL_REPLY_TO=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
